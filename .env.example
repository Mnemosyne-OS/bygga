# Together AI key: unlocks any product name, photo lookup, live help, and the
# hands-free voice on lines that have no pre-recorded clip (scanned manuals,
# spoken help answers). Without it those lines use the device's own voice.
# Scanning a manual (/scan) always uses the visitor's own key instead.
# Re-record the voice clips with `npm run voice`. Get a key at https://api.together.ai
TOGETHER_API_KEY=

# Optional: the GitHub repo shown (with its star count) in the nav.
# NEXT_PUBLIC_GITHUB_REPO=Luffixos/bygga

# Optional: comma separated model lists, tried in order.
# TOGETHER_TEXT_MODEL=openai/gpt-oss-120b,zai-org/GLM-5.3-Flash
# TOGETHER_VISION_MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL,MiniMaxAI/MiniMax-M3
# TOGETHER_READ_MODEL=MiniMaxAI/MiniMax-M3,nvidia/NVIDIA-Nemotron-3.5-Super-VL
# TOGETHER_PLAN_MODEL=openai/gpt-oss-120b,zai-org/GLM-5.3-Flash
