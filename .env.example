# Together AI key: unlocks any product name, photo lookup and live help for everyone.
# Scanning a manual (/scan) always uses the visitor's own key instead.
# Get one at https://api.together.ai
TOGETHER_API_KEY=

# Optional: the GitHub repo shown (with its star count) in the nav.
# NEXT_PUBLIC_GITHUB_REPO=Luffixos/bygga

# Optional: comma separated model lists, tried in order.
# TOGETHER_TEXT_MODEL=openai/gpt-oss-120b,zai-org/GLM-5.2
# TOGETHER_VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct,meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8
# TOGETHER_PLAN_MODEL=openai/gpt-oss-120b,deepseek-ai/DeepSeek-V3.1
